#include<stdio.h>
#define MAX 5
int stack[MAX];
int top=-1;
void push()
{
    int value,top;
    if (top==MAX-1)
    {
        printf("stack is empty\n");
    }
    else
    {
        printf("enter element to push:");
        scanf("%d",&value);
        top++;
        stack[top]=value;
        printf("%d push into a stack",value);
    }
}
void pop()
{
    int i,top;
    if (top==-1){
        printf("stack underflow\n");
    }
    else
    {
        printf("stack element are:\n");
        for(i=top;i>=0;i--)
        {
            printf("%d\n",stack[i]);
        }
    }
}

